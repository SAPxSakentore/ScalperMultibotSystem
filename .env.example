# ============================================
# KazBuildOS — Конфигурация окружения
# ============================================
# Скопируйте этот файл в .env и заполните значения

# Anthropic Claude API ключ (обязателен для AI-агентов)
ANTHROPIC_API_KEY=sk-ant-...your-key-here...

# Режим работы
DEBUG=false
OFFLINE_MODE=false

# Компания
COMPANY_NAME=KazBuildOS Systems
COMPANY_BIN=000000000000
COMPANY_ADDRESS=г. Алматы, Республика Казахстан

# База данных (по умолчанию SQLite для оффлайн работы)
DATABASE_URL=sqlite+aiosqlite:///./kazbuildos.db

# Секретный ключ (измените в production!)
SECRET_KEY=change-this-in-production-very-secret-key
